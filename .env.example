# Terbium v2 Backend/Environment Configuration
# Copy this file to .env and configure according to your deployment needs or simply run the bootstrapper to automatically populate it

# ============================================================================
# MASQR-v2 Activation System (Replaces legacy MASQR)
# ============================================================================
# MASQR-v2 provides secure activation-based access control with cryptographic
# signatures, session management, and comprehensive audit logging.

# Enable or disable activation requirement (true/false)
VITE_ACTIVATION_ENABLED=false

# License server URL (required if VITE_ACTIVATION_ENABLED=true)
# Example: http://localhost:4000 or https://license.yourdomain.com
LICENSE_SERVER_URL=

# ============================================================================
# Server Configuration
# ============================================================================

# Port for the main Terbium HTTP server
PORT=3000

# Port for the Wisp WebSocket server (proxy connections)
WISP_PORT=6001

# External Wisp Server (optional - for static hosting)
# If not set, Terbium will use the built-in Wisp server
# VITE_WISP_SERVER=wss://wisp.example.com/wisp/

# IP Reputation Storage (optional)
# Store IP reputation data to block known malicious actors
# REPUTATION_STORE=./data/reputation.json

# ============================================================================
# Additional Notes
# ============================================================================
# - Wisp endpoint path is hardcoded to /wisp/ and cannot be changed
# - DNS servers are hardcoded to 1.1.1.3 and 1.0.0.3 (Cloudflare malware blocking)
# - Changes to .env require a server restart
# - Never commit .env to version control - add it to .gitignore

# For development/testing, you can leave ACTIVATION_ENABLED=false
